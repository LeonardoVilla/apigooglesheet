# Variáveis de ambiente do servidor (Next.js Route Handlers / Vercel).
# NUNCA prefixe estas com NEXT_PUBLIC_ — elas não devem ir para o front-end.
# Veja o guia de configuração no README.md ("Configuração do Google Cloud Console").

# Client ID e Client Secret do OAuth 2.0 criado no Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Precisa ser cadastrado como "URI de redirecionamento autorizado" no Cloud Console.
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback"

# Chave usada para assinar o cookie de sessão (HMAC). Gere com: openssl rand -base64 32
SESSION_SECRET=""

# URL base da aplicação, usada para montar os redirects do fluxo OAuth.
APP_BASE_URL="http://localhost:3000"
